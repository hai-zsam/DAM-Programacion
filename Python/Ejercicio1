# Ejercicio 1
# Se pide un numero al usuario——input siempre devuelve String
num = int(input("Ingrese un numero: "))
longitud = len(str(num))

# Imprimir título
print(f"Tabla de multiplicar del {num}:")

# Función para la cabecera / pie
def imprimir_rayas():
    print("=" * (longitud + 4))

# Imprimir la cabecera
imprimir_rayas()

# Crear bucle del 1 al 10
for i in range(1, 11):
    # Mostrar el resultado de cada multiplicación
    print(f"{num} x {i} = {num * i}")

# Imprimir el pie
imprimir_rayas()
